[Unit]
Description=MMM Studio AI - Microservicio de Optimizacion Fotografica
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/mmmvenezuela/app/Scripts
Environment="PATH=/var/www/mmmvenezuela/app/Scripts/venv/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/var/www/mmmvenezuela/app/Scripts/venv/bin/uvicorn ai_server:app --host 0.0.0.0 --port 8001 --workers 1 --log-level info
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

