{
  "expo": {
    "name": "PRESBITERIO CN2026",
    "slug": "presbiterio-cn2026",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mmmvenezuela.presbiterio",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Permite el uso de Face ID para ingresar de forma rápida y segura al Portal Ejecutivo de Presbíteros y Supervisión.",
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "com.mmmvenezuela.presbiterio",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.VIBRATE"
      ],
      "predictiveBackGestureEnabled": false
    },
    "androidStatusBar": {
      "barStyle": "light-content",
      "backgroundColor": "#090d16",
      "translucent": false
    },
    "androidNavigationBar": {
      "visible": "visible",
      "barStyle": "light-content",
      "backgroundColor": "#090d16"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "Presbiterio MMM",
      "shortName": "Presbiterio",
      "backgroundColor": "#090d16",
      "themeColor": "#090d16"
    },
    "experiments": {
      "baseUrl": "/app-presbiterio"
    },
    "plugins": [
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Permite el uso de Face ID para ingresar de forma rápida y segura al Portal Ejecutivo de Presbíteros y Supervisión."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#0284c7"
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/cocogoose-bold.ttf",
            "./assets/fonts/cocogoose-regular.ttf"
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "ed7c89b4-be4b-4008-beee-8b5e1cd53a9a"
      }
    },
    "owner": "theizerdev"
  }
}
